{
  "title": "DevOps Portfolio",
  "uid": "devops-portfolio",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "HTTP requests / second", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }, "targets": [{ "expr": "sum(rate(http_requests_total[5m]))", "legendFormat": "requests/s" }] },
    { "id": 2, "type": "timeseries", "title": "HTTP 5xx rate", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }, "targets": [{ "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[5m]))", "legendFormat": "errors/s" }] },
    { "id": 3, "type": "timeseries", "title": "HTTP p95 latency", "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95 seconds" }] },
    { "id": 4, "type": "timeseries", "title": "Running portfolio pods", "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 }, "targets": [{ "expr": "count(kube_pod_status_phase{pod=~\".*portfolio.*\",phase=\"Running\"} == 1)", "legendFormat": "pods" }] }
  ]
}
