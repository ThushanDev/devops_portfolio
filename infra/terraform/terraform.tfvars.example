aws_region    = "ap-south-1"
project_name  = "devops-portfolio"
my_ip_cidr    = "203.0.113.10/32" # Replace with your own current public IP.
instance_type = "t3.micro"
k3s_version   = "v1.37.1+k3s1"
public_key    = "ssh-ed25519 AAAA... replace-with-your-public-key"
terraform_state_bucket = "replace-with-bootstrap-output"
terraform_lock_table = "devops-portfolio-tf-lock"
