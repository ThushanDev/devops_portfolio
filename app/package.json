{
  "name": "devops-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "A small portfolio app demonstrating a secure delivery pipeline.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "vite --config vite.config.mjs --host 0.0.0.0",
    "build": "vite build --config vite.config.mjs",
    "pretest": "npm run build",
    "test": "jest --runInBand",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "clean": "node -e \"require('fs').rmSync('coverage', { recursive: true, force: true })\""
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@prometheus-io/client": "0.16.1",
    "compression": "1.8.2",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "vite": "^7.1.0"
  }
}
